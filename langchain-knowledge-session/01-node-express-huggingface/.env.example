# Server Port
PORT=3001

# Hugging Face User Access Token (read permissions)
# Get yours for free at: https://huggingface.co/settings/tokens
HF_TOKEN=your_huggingface_access_token_here

# Hugging Face Model ID
# You can change this to any supported model on the Hugging Face router:
# Examples:
#   - meta-llama/Llama-3.1-8B-Instruct
#   - Qwen/Qwen2.5-7B-Instruct
#   - google/gemma-3-4b-it
HF_MODEL=meta-llama/Llama-3.1-8B-Instruct
